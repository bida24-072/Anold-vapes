<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact | Anold Vapes (AV)</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="age-gate" id="age-gate">
        <div class="age-gate-inner">
            <div class="age-gate-logo">ANOLD VAPES</div>
            <div class="age-gate-tag">Premium Vape · Gaborone</div>
            <h2>Are you 18 or older?</h2>
            <div class="age-gate-buttons">
                <button class="btn" onclick="confirmAge()"><i class="fas fa-check"></i> Yes</button>
                <button class="btn btn-outline" onclick="denyAge()"><i class="fas fa-times"></i> No</button>
            </div>
        </div>
    </div>

    <div class="top-bar">
        <i class="fas fa-comments"></i> Fastest response on WhatsApp · Open 7 days a week
    </div>

    <header>
        <div class="container nav-container">
            <a href="index.html" class="logo">
                <div class="logo-mark">AV</div>
                <div>
                    <div class="logo-text">Anold Vapes</div>
                    <span class="logo-sub">PREMIUM · GABORONE</span>
                </div>
            </a>
            <nav>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>
                        <a href="shop.html">Shop <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown">
                            <a href="shop.html"><i class="fas fa-wind"></i> Disposables</a>
                            <a href="shop.html"><i class="fas fa-battery-full"></i> Pod Systems</a>
                            <a href="shop.html"><i class="fas fa-cube"></i> Mods</a>
                            <a href="shop.html"><i class="fas fa-flask"></i> E-Liquids</a>
                            <a href="shop.html"><i class="fas fa-tint"></i> Nic Salts</a>
                            <a href="shop.html"><i class="fas fa-cog"></i> Coils & Pods</a>
                        </div>
                    </li>
                    <li><a href="shop.html">Wholesale</a></li>
                    <li><a href="contact.html" class="active">Contact</a></li>
                </ul>
            </nav>
            <div class="nav-icons">
                <button class="nav-icon-btn"><i class="fas fa-search"></i></button>
                <button class="nav-icon-btn" onclick="toggleCart()">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-count" id="cart-count">0</span>
                </button>
                <button class="mobile-menu-btn" onclick="toggleMobileMenu()"><i class="fas fa-bars"></i></button>
            </div>
        </div>
    </header>
    <div class="mobile-overlay" onclick="toggleMobileMenu()"></div>

    <section class="page-hero">
        <div class="container">
            <h1>Get in <em>Touch</em></h1>
            <p>Order enquiries, product questions, wholesale, delivery — we're here.</p>
        </div>
    </section>

    <main class="container">
        <div class="breadcrumbs">
            <a href="index.html">Home</a>
            <span class="sep">/</span>
            <span>Contact</span>
        </div>

        <div class="contact-grid">
            <div class="contact-info">
                <h2>Reach <em>Anold Vapes.</em></h2>
                <p>The fastest way to reach us is WhatsApp. Send a message and we'll reply within an hour during business hours.</p>

                <div class="contact-channels">
                    <a href="https://wa.me/26771234567" target="_blank" class="contact-channel">
                        <div class="icon wa"><i class="fab fa-whatsapp"></i></div>
                        <div class="contact-channel-info">
                            <h4>WhatsApp</h4>
                            <p>+267 71 234 567 · Fastest reply</p>
                        </div>
                    </a>
                    <a href="#" target="_blank" class="contact-channel">
                        <div class="icon ig"><i class="fab fa-instagram"></i></div>
                        <div class="contact-channel-info">
                            <h4>Instagram</h4>
                            <p>@anoldvapes · Daily stock updates</p>
                        </div>
                    </a>
                    <a href="#" target="_blank" class="contact-channel">
                        <div class="icon tt"><i class="fab fa-tiktok"></i></div>
                        <div class="contact-channel-info">
                            <h4>TikTok</h4>
                            <p>@anoldvapes · Unboxings & reviews</p>
                        </div>
                    </a>
                    <a href="#" target="_blank" class="contact-channel">
                        <div class="icon fb"><i class="fab fa-facebook-f"></i></div>
                        <div class="contact-channel-info">
                            <h4>Facebook</h4>
                            <p>Anold Vapes BW</p>
                        </div>
                    </a>
                    <a href="mailto:hello@anoldvapes.co.bw" class="contact-channel">
                        <div class="icon em"><i class="fas fa-envelope"></i></div>
                        <div class="contact-channel-info">
                            <h4>Email</h4>
                            <p>hello@anoldvapes.co.bw</p>
                        </div>
                    </a>
                </div>

                <div class="contact-detail">
                    <span class="label">Location</span>
                    <span class="value">Gaborone, Botswana</span>
                </div>
                <div class="contact-detail">
                    <span class="label">Hours</span>
                    <span class="value">Mon–Sat · 9AM–7PM</span>
                </div>
                <div class="contact-detail">
                    <span class="label">Delivery</span>
                    <span class="value">Same-day in Gabs</span>
                </div>
                <div class="contact-detail">
                    <span class="label">Wholesale</span>
                    <span class="value">Min. P3,000 order</span>
                </div>
            </div>

            <div class="form-container">
                <h3>Send a Message</h3>
                <form onsubmit="submitContact(event)">
                    <div class="form-group">
                        <label for="c-name">Your Name</label>
                        <input type="text" id="c-name" required placeholder="e.g. Kabelo M.">
                    </div>
                    <div class="form-group">
                        <label for="c-phone">WhatsApp Number</label>
                        <input type="tel" id="c-phone" required placeholder="+267 ...">
                    </div>
                    <div class="form-group">
                        <label for="c-subject">Subject</label>
                        <select id="c-subject">
                            <option>Order Enquiry</option>
                            <option>Product Question</option>
                            <option>Delivery Info</option>
                            <option>Wholesale Enquiry</option>
                            <option>Complaint / Feedback</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="c-message">Message</label>
                        <textarea id="c-message" rows="5" required placeholder="What do you need?"></textarea>
                    </div>
                    <button type="submit" class="btn" style="width: 100%; justify-content: center;">
                        Send Message <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="footer-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <p><strong>WARNING:</strong> Nicotine is an addictive chemical. Not for sale to persons under 18.</p>
            </div>
            <div class="footer-top">
                <div class="footer-brand">
                    <h3>Anold <span>Vapes</span></h3>
                    <small>PREMIUM · GABORONE</small>
                    <p>Botswana's trusted source for authentic vape products.</p>
                    <div class="footer-socials">
                        <a href="#"><i class="fab fa-whatsapp"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-tiktok"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                    </div>
                </div>
                <div class="footer-col"><h4>Shop</h4><ul>
                    <li><a href="shop.html">All Products</a></li>
                    <li><a href="shop.html">Disposables</a></li>
                </ul></div>
                <div class="footer-col"><h4>Info</h4><ul>
                    <li><a href="contact.html">Contact</a></li>
                    <li><a href="contact.html">Wholesale</a></li>
                </ul></div>
                <div class="footer-col"><h4>Visit</h4><ul>
                    <li>Gaborone, Botswana</li>
                    <li>+267 71 234 567</li>
                    <li>hello@anoldvapes.co.bw</li>
                </ul></div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 ANOLD VAPES</span>
                <span>18+ ONLY</span>
            </div>
        </div>
    </footer>

    <div class="cart-overlay" id="cart-overlay" onclick="closeCart()"></div>
    <aside class="cart-drawer" id="cart-drawer">
        <div class="cart-header">
            <h3>Your Cart</h3>
            <button onclick="closeCart()"><i class="fas fa-times"></i></button>
        </div>
        <div class="cart-items" id="cart-items"></div>
        <div class="cart-footer">
            <div class="cart-total-row">
                <span>Total</span>
                <strong id="cart-total">P0.00</strong>
            </div>
            <button class="cart-checkout-btn" onclick="checkoutCart()">
                <i class="fab fa-whatsapp"></i> Order via WhatsApp
            </button>
        </div>
    </aside>

    <script src="main.js"></script>
</body>
</html>
